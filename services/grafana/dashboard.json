      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "wnfit-mysql"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT /*+ MAX_EXECUTION_TIME(5000) */ $__timeGroupAlias(created_at,'1d'), COUNT(*) AS clientes FROM clients WHERE $__timeFilter(created_at) AND id IN (${client:sqlstring}) GROUP BY 1 ORDER BY 1",
          "format": "time_series"
        }
      ],
