    {
      "id": 15,
      "type": "table",
      "title": "Carteira de clientes",
      "description": "Totais por organização. Não indica clientes pagantes. Não apresenta contatos ou dados clínicos dos alunos.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "mysql",
        "uid": "wnfit-mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "wnfit-mysql"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT /*+ MAX_EXECUTION_TIME(5000) */ id AS ID, client_name AS Cliente, IF(enabled=1,'Ativo','Inativo') AS Cadastro, students AS Alunos, active_students AS 'Alunos ativos', staff AS Equipe, workouts AS Treinos, events AS Eventos, workout_sessions_30d AS 'Sessões em 30 dias', created_at AS 'Criado em' FROM clients WHERE id IN (${client:sqlstring}) ORDER BY students DESC, id",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": []
        },
