APP_NAME=WNFIT
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MESSAGING_MODE=manual
TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_DRIVER=twilio
TWILIO_WHATSAPP_CHARGE_TEMPLATE_SID=
TWILIO_WHATSAPP_WELCOME_TEMPLATE_SID=
TWILIO_WHATSAPP_STATUS_CALLBACK_URL="${APP_URL}/api/webhooks/twilio/whatsapp/status"

# Required before enabling production album uploads; confirm storage persistence across deployments.
EVENT_PHOTO_DISK=s3
EVENT_PHOTO_STORAGE_PERSISTENT=false

# Leave empty only after the pilot is validated to release all linked participants.
EVENT_EXPERIENCE_PILOT_USERNAME=wendel
